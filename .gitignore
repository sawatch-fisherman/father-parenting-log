# src/配下はLaravel Boostが生成する共有ガイド・スキルのため追跡対象に戻す
!src/CLAUDE.md
!src/.claude/

# =========================
# Laravel / PHP
# Laravel本体を src/ 配下に配置する構成
# =========================
src/vendor/
src/.phpunit.result.cache
src/.phpunit.cache/
src/storage/logs/*.log
src/storage/framework/cache/data/*
src/storage/framework/sessions/*
src/storage/framework/views/*
src/bootstrap/cache/*.php

# Laravel generated key / local storage
src/storage/*.key

# =========================
# Node / Vue / Vite
# =========================
src/node_modules/
src/npm-debug.log*
src/yarn-debug.log*
src/yarn-error.log*
src/pnpm-debug.log*
src/.vite/
src/public/build/
src/dist/

# =========================
# Test / Coverage
# =========================
src/coverage/
src/.nyc_output/

# =========================
# Docker local data
# =========================
docker/mysql/data/
docker/postgres/data/
docker/redis/data/

